# ---- LLM / Embedding ----
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=nlpai-lab/KURE-v1
LLM_MAX_CONCURRENCY=3

# ---- OCR ----
UPSTAGE_API_KEY=

# ---- Pinecone RAG ----
PINECONE_API_KEY=
PINECONE_INDEX=a-law
RAG_ADMIN_TOKEN=replace-with-random-admin-token
RERANKER_ENABLED=true

# ---- 내부 API 인증 (Spring Boot -> FastAPI, X-Internal-Token 헤더) ----
# 비워두면 인증 없이 동작합니다(로컬 개발 전용). 운영에서는 반드시 32자 이상으로 설정하세요.
API_INTERNAL_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
S3_ALLOWED_PREFIX=

# ---- RabbitMQ (Spring Boot 연동) ----
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
ANALYSIS_QUEUE=contract.analysis.queue
RESULT_EXCHANGE=contract.analysis.result
RESULT_QUEUE=ai.result.queue
RESULT_ROUTING_KEY=ai.result
ANALYSIS_DLQ=contract.analysis.dlq
ANALYSIS_MAX_RETRIES=3

# ---- Redis (챗봇 세션) ----
REDIS_URL=redis://localhost:6379/0
CHAT_SESSION_TTL=3600

# ---- AWS S3 ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=alaw-contracts
